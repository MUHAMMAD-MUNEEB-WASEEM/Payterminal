# PayTerminal backend configuration
#
# Copy to .env for local development. In production these are set as
# environment variables on the Render service.

# ---------------------------------------------------------------------------
# Feature toggle
# ---------------------------------------------------------------------------
# latest = the updated behaviour (default)
# legacy = exactly what the app did before any of it was added
PT_MODE=latest

# Each change can also be switched off on its own. An individual setting wins
# over PT_MODE, so you can roll back one thing without reverting the rest:
#
#   PT_DATA_PATH_MODE      write the database to the mounted Render disk
#   PT_SUPERADMIN_MODE     take the super admin password from the environment
#   PT_ADMIN_SEED_MODE     stop creating an admin/admin account on boot
#   PT_MAINTENANCE_ENFORCE apply maintenance mode to the API, not just the UI
#   PT_CORS_MODE           restrict CORS to ALLOWED_ORIGINS
#   PT_RATE_LIMIT          throttle repeated failed logins
#
# Example — everything new except the CORS change:
#   PT_MODE=latest
#   PT_CORS_MODE=legacy

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
# Public URL of this API. BrokerPay sends customers back to it after 3D Secure
# and posts webhooks to it. Worked out from the request when unset.
BACKEND_URL=

# ---------------------------------------------------------------------------
# Super admin
# ---------------------------------------------------------------------------
# The account is not in the database. Until SUPER_ADMIN_PASSWORD is set, the
# password that was committed to this repository still works and the server
# warns about it on every boot.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
# Set to true to switch the account off entirely.
SUPER_ADMIN_DISABLED=false

# ---------------------------------------------------------------------------
# First admin account
# ---------------------------------------------------------------------------
# Only used when the database has no users at all. Leave the password blank to
# have one generated and printed to the logs once.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@uspto.com
ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated. While this is empty the API accepts every origin.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Login throttling
# ---------------------------------------------------------------------------
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000
